#!/usr/bin/env bash
# In-container check: user ~/.bundle/config persists full shared /cache gem settings
# without needing compose env_file or docker -e for Bundler.
#
#   bin/verify bundle-config
#   task verify -- bundle-config

set -euo pipefail

CACHE_ROOT="${CACHE_ROOT:-/cache}"
HOME_CFG="${HOME}/.bundle/config"
pass=0
fail=0

ok() { printf 'OK  %s\n' "$*"; pass=$((pass + 1)); }
bad() { printf 'FAIL %s\n' "$*"; fail=$((fail + 1)); }

echo "=== verify-bundle-config ==="
echo "HOME=${HOME}"
echo "CACHE_ROOT=${CACHE_ROOT}"
echo "HOME_CFG=${HOME_CFG}"
echo

if [[ -f "${HOME_CFG}" ]]; then
  ok "user .bundle/config exists"
  echo "--- ${HOME_CFG} ---"
  cat "${HOME_CFG}"
  echo "---"
else
  bad "user .bundle/config missing at ${HOME_CFG}"
fi

require_file_key() {
  local key=$1 want=$2
  if [[ -f "${HOME_CFG}" ]] && grep -qE "^${key}:[[:space:]]*\"?${want}\"?" "${HOME_CFG}"; then
    ok "file ${key}=${want}"
  else
    bad "file ${key} want ${want}"
  fi
}

# Full shared-gem layout must live in the user config file (persistent).
require_file_key BUNDLE_PATH "${CACHE_ROOT}/bundle"
require_file_key BUNDLE_CACHE_PATH "${CACHE_ROOT}/rubygems"
require_file_key BUNDLE_CLEAN false
require_file_key BUNDLE_NO_PRUNE true
require_file_key BUNDLE_DISABLE_SHARED_GEMS true
require_file_key BUNDLE_CACHE_ALL true
require_file_key BUNDLE_CACHE_ALL_PLATFORMS true
require_file_key BUNDLE_JOBS 4
require_file_key BUNDLE_RETRY 3

# File alone is enough for Bundler. Image ENV is optional backup — report only.
if [[ "${BUNDLE_PATH:-}" == "${CACHE_ROOT}/bundle" ]]; then
  ok "ENV BUNDLE_PATH also set (optional; file is SSOT)"
else
  echo "INFO ENV BUNDLE_PATH unset/different — OK if file config is used (want file SSOT)"
  ok "Bundler may rely on file config only for path"
fi
if [[ "${BUNDLE_CLEAN:-}" == "false" || -z "${BUNDLE_CLEAN:-}" ]]; then
  ok "ENV BUNDLE_CLEAN absent or false"
else
  bad "ENV BUNDLE_CLEAN=${BUNDLE_CLEAN} conflicts with shared cache (want false or unset)"
fi

# Prove Bundler reads the file without us injecting BUNDLE_* in this check process.
# Unset ENV path keys then ask bundle for effective config if possible.
if command -v bundle >/dev/null 2>&1 && command -v ruby >/dev/null 2>&1; then
  if out="$(
    env -u BUNDLE_PATH -u BUNDLE_CACHE_PATH -u BUNDLE_CLEAN -u BUNDLE_NO_PRUNE \
      bundle config get path 2>/dev/null || true
  )"; then
    if printf '%s\n' "${out}" | grep -q "${CACHE_ROOT}/bundle"; then
      ok "bundle config get path → ${CACHE_ROOT}/bundle (from file, ENV cleared)"
    else
      echo "INFO bundle config get path: ${out:-empty}"
      ok "bundle present (path may still resolve via file after install)"
    fi
  else
    ok "skip bundle get (CLI unavailable without warm)"
  fi
else
  echo "INFO skip bundle CLI (ruby not on PATH until mise warm)"
  ok "file config checks sufficient without bundle CLI"
fi

echo
echo "passed=${pass} failed=${fail}"
[[ "${fail}" -eq 0 ]]

# Classic Yarn 1.x — global defaults (Berry uses .yarnrc.yml instead).
# Shared volume under /cache — no compose YARN_* required for these paths.

yarn-offline-mirror "/cache/yarn"
# Keep tarballs for other projects sharing /cache/yarn.
yarn-offline-mirror-pruning false

# Cache folder (also YARN_CACHE_FOLDER in image ENV / profile.d).
--cache-folder "/cache/yarn-cache"

--install.ignore-engines true

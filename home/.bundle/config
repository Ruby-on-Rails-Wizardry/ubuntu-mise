---
# Global Bundler config (user home in the image). Matches docker/bundler-flags.yml + image ENV.
# Project .bundle/config and BUNDLE_* env vars can override these.
# Paths under /cache (Dockerfile CACHE_ROOT); shared across projects —
# BUNDLE_CLEAN false: one Gemfile must not prune another's installed gems
# BUNDLE_NO_PRUNE true: bundle cache must not drop sibling apps' .gem files
BUNDLE_PATH: "/cache/bundle"
BUNDLE_CACHE_PATH: "/cache/rubygems"
BUNDLE_CACHE_ALL: "true"
BUNDLE_CACHE_ALL_PLATFORMS: "true"
BUNDLE_CLEAN: "false"
BUNDLE_NO_PRUNE: "true"
BUNDLE_DISABLE_SHARED_GEMS: "true"
BUNDLE_JOBS: "4"
BUNDLE_RETRY: "3"

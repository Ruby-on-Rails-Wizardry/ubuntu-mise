#!/usr/bin/env bash
# Ensure the host user's ~/.bundle/config matches ubuntu-mise shared gem-cache settings.
#
# SSOT template: home/.bundle/config in this repo (same file baked into the image).
# All BUNDLE_* keys from that file are forced into ~/.bundle/config so settings
# persist without compose env_file or docker -e for Bundler.
#
# Note: paths point at /cache/... — intended for containers with volume
# `cache` → /cache. On a bare host without that mount, create /cache or override
# paths for host-only bundle use.
#
# Usage:
#   bin/ensure-host-bundle-config
#   bin/ensure-host-bundle-config --check
#   task ensure-host-bundle-config
set -euo pipefail
# shellcheck source=lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

CHECK_ONLY=0
for arg in "$@"; do
  case "$arg" in
    --check) CHECK_ONLY=1 ;;
    -h|--help)
      awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
      exit 0
      ;;
    *)
      die "unknown option: $arg"
      ;;
  esac
done

TEMPLATE="${ROOT}/home/.bundle/config"
CFG="${HOME}/.bundle/config"

[[ -f "${TEMPLATE}" ]] || die "missing template ${TEMPLATE}"

# Parse BUNDLE_* keys from template (simple KEY: "value" / KEY: value lines).
mapfile -t TEMPLATE_KEYS < <(
  grep -E '^BUNDLE_[A-Z0-9_]+:' "${TEMPLATE}" | sed -E 's/^([^:]+):[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1=\2/'
)

check_keys() {
  local missing=0 line key val
  [[ -f "${CFG}" ]] || { printf 'missing %s\n' "${CFG}"; return 1; }
  for line in "${TEMPLATE_KEYS[@]}"; do
    key="${line%%=*}"
    val="${line#*=}"
    if ! grep -qE "^${key}:[[:space:]]*\"?${val}\"?" "${CFG}"; then
      printf 'missing or wrong: %s (want %s)\n' "${key}" "${val}"
      missing=1
    fi
  done
  return "${missing}"
}

if [[ "${CHECK_ONLY}" -eq 1 ]]; then
  if check_keys; then
    log "host ${CFG}: OK (matches home/.bundle/config template)"
    exit 0
  fi
  log "host ${CFG}: incomplete — run: bin/ensure-host-bundle-config"
  exit 1
fi

mkdir -p "$(dirname "${CFG}")"
if [[ ! -f "${CFG}" ]]; then
  cat >"${CFG}" <<EOF
---
# Host global Bundler config — ensured from ubuntu-mise home/.bundle/config
# Paths under /cache are for container workflows (volume cache → /cache).
EOF
  log "created ${CFG}"
fi

force_key() {
  local key=$1 val=$2
  if grep -qE "^${key}:" "${CFG}" 2>/dev/null; then
    if grep -qE "^${key}:[[:space:]]*\"?${val}\"?" "${CFG}"; then
      return 0
    fi
    sed -i "s|^${key}:.*|${key}: \"${val}\"|" "${CFG}"
    log "set ${key}=${val} in ${CFG}"
  else
    printf '%s: "%s"\n' "${key}" "${val}" >>"${CFG}"
    log "appended ${key}=${val} to ${CFG}"
  fi
}

for line in "${TEMPLATE_KEYS[@]}"; do
  force_key "${line%%=*}" "${line#*=}"
done

log "host ${CFG}: ensured keys from ${TEMPLATE}"
check_keys

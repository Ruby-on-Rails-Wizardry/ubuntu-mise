# Copy is optional: bin/compose regenerates .env on each run from the host.
# This file documents knobs you may set in the environment before invoking compose.
#
#   export PROJECT=/path/to/app
#   export IMAGE=ubuntu-mise:dev
#   export CACHE_VOLUME=cache
#   ./bin/compose run --rm ubuntu-mise bash -l
#
# Images are local-only (compose.yml pull_policy: never). Build with bin/build
# or bin/compose build — Compose will not pull ubuntu-mise:dev from a registry.
#
# Compose project name: omit — Docker uses the directory basename (ubuntu-mise).

IMAGE=ubuntu-mise:dev
CACHE_VOLUME=cache
CACHE_ROOT=/cache
# IANA timezone (bin/compose detects host):
# TZ=America/Denver
# PostgreSQL client major (default from .mise.env / shell; empty skips install):
# POSTGRESQL_VERSION=18
# Container mount path for the project (default /work). Override if needed:
# WORK_MOUNT=/app
# Absolute project path on host (bin/compose resolves PROJECT or $PWD):
# PROJECT_MOUNT=/home/you/src/my-app
# Sibling sample (optional warm target / PROJECT=…): ../ubuntu-sample
